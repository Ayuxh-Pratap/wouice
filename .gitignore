node_modules/
dist/
out/
build/
.vite/
*.log

# Large binaries and weights, never committed.
# ANCHORED with a leading slash. Unanchored `sidecars/` matches at ANY depth,
# which silently excluded app/v1/desktop/src/main/sidecars/ (the whole supervisor
# implementation) from the repo. git status does not report ignored files, so
# nothing pointed at it. Same trap applies to models/.
/sidecars/
/models/
*.gguf
*.bin
*.onnx

# local data and secrets
.env
.env.*
!.env.example
data/
*.sqlite
*.sqlite-*

# third-party sample audio, local only
app/v1/fixtures/

# esbuild output used only by the injection acceptance test
app/v1/scripts/build/

# design mockups and their preview server's state, local only
.superpowers/

# Isolated Projects native/UI smoke-test data.
app/v1/.projects-probe/
app/v1/projects-pty-result.json

{
  "name": "wouice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal local voice suite: dictation, meetings, companion",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "desktop"
  ],
  "scripts": {
    "fetch:sidecars": "node scripts/fetch-sidecars.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "fetch:all": "node scripts/fetch-sidecars.mjs && node scripts/fetch-models.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "verify": "node scripts/verify-artifacts.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
